# Copy to .env.local. next dev reads it, and e2e.config.ts loads it for the test runner.

# The Paddle sandbox's API key: sandbox-vendors.paddle.com → Developer tools → Authentication → API keys.
PADDLE_API_KEY=pdl_sdbx_apikey_...

# The sandbox's client-side token, for Paddle.js in the browser: same page, Client-side tokens.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...

# The agent's model, through the Vercel AI Gateway. Only agent steps need it.
AI_GATEWAY_API_KEY=

# Optional: test another URL. Defaults to http://localhost:3000.
# APP_URL=
